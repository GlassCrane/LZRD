<?xml version="1.0" encoding="utf-8"?>
<!-- One mood: the transparent animation floating on the ground, in a HUD frame. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.glasscrane.flannery.ui.FlanneryView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp" />

        <com.glasscrane.flannery.ui.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@color/mint" />

        <TextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/on_dark"
            android:textSize="11sp"
            android:letterSpacing="0.10"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/indexTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mint_dim"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</LinearLayout>
