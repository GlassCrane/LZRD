<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_ground"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/back_glyph"
            android:textColor="@color/mint"
            android:textSize="17sp"
            android:fontFamily="monospace"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@color/line" />

        <TextView
            android:id="@+id/indexReadout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mint_dim"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/detailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/on_dark"
        android:textSize="22sp"
        android:letterSpacing="0.12"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detailBlurb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/mint_deep"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:fontFamily="monospace" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp">

        <com.glasscrane.flannery.ui.FlanneryView
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp" />

        <View
            android:id="@+id/scanLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/line_bright" />

        <com.glasscrane.flannery.ui.HudFrameView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="210dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_mint"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/progressLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/making_gif"
        android:textColor="@color/on_dark_soft"
        android:textSize="11sp"
        android:letterSpacing="0.10"
        android:fontFamily="monospace"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="26dp">

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:minWidth="108dp"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/save_gif"
            android:textAllCaps="true"
            android:textColor="@color/mint"
            android:textSize="13sp"
            android:letterSpacing="0.10"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/shareBtn"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:minWidth="152dp"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/share_gif"
            android:textAllCaps="true"
            android:textColor="@color/mint_ink"
            android:textSize="13sp"
            android:letterSpacing="0.10"
            android:fontFamily="monospace"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
